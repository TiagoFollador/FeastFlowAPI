# Configuração do Banco de Dados PostgreSQL
# IMPORTANTE: O usuário do banco NÃO PODE ser superuser nem ter BYPASSRLS
# para garantir a segurança do Row Level Security
DATABASE_URL="postgresql://feastflow_user:senha_segura@localhost:5432/feastflow_db?schema=public"

# JWT Configuration
JWT_SECRET="sua_chave_secreta_jwt_aqui_min_256_bits"
JWT_EXPIRATION="7d"

# Application Configuration
NODE_ENV="development"
PORT=3000

# Logging
LOG_LEVEL="debug"
